# Copy to .env and fill in. Never commit .env.

# Meta Model API key (dev.meta.ai -> API keys). Used for the agent model only.
MODEL_API_KEY=

# --- Private plane (optional). Without VEIL_GUARD_URL the AI checker is OFF and
# Veil uses rules only (raw text is never sent to a hosted API by default).
# Without VEIL_SAM, faces and ID cards are not masked as regions. ---
# Muse Glimmer on your Modal (modal deploy infra/modal_glimmer.py)
VEIL_GUARD_URL=https://<your-workspace>--veil-glimmer-serve.us-east.modal.run/v1
VEIL_GUARD_KEY=
VEIL_GUARD_MODEL=muse-glimmer

# SAM 3.1 on your Modal (modal deploy infra/modal_sam.py)
VEIL_SAM=private
VEIL_SAM_URL=https://<your-workspace>--veil-sam-sam-web.us-east.modal.run
VEIL_SAM_KEY=

# Proxy spend cap in USD (429 once reached)
VEIL_BUDGET_USD=100
